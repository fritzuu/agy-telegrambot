# Telegram Bot API Token dari @BotFather
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Set ke true jika ingin agy otomatis eksekusi tools (bash/file edit) tanpa konfirmasi manual
AUTO_APPROVE_TOOLS=false

# Whitelist Telegram User ID (wajib diisi demi keamanan, pisahkan dengan koma jika lebih dari satu)
# Contoh: "12345678" atau "12345678,98765432"
ALLOWED_TELEGRAM_USERS="12345678"

# Model Faster-Whisper untuk transkrip Voice Note (opsional, default: "base", opsi: "tiny", "base", "small")
WHISPER_MODEL="base"

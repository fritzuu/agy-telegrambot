# Telegram Bot API Token dari @BotFather
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Set ke true jika ingin agy otomatis eksekusi tools (bash/file edit) tanpa konfirmasi manual
AUTO_APPROVE_TOOLS=false

# Whitelist Telegram User ID (pisahkan dengan koma jika lebih dari satu, contoh: "12345678,98765432")
# Kosongkan ("") jika ingin mengizinkan siapa saja (mode publik)
ALLOWED_TELEGRAM_USERS=""
